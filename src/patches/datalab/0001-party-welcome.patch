+<!-- This file was edited with the assistance of an AI model and requires human review from the contributor. -->
+<template>
+  <div v-if="active" class="party-welcome" aria-live="polite">
+    <div class="party-card shadow" role="dialog" aria-label="Welcome message">
+      <button type="button" class="close party-close" aria-label="Close" @click="stop">
+        <span aria-hidden="true">&times;</span>
+      </button>
+      <div class="party-trophy" aria-hidden="true">🏆</div>
+      <h2 class="h4 font-weight-bold mb-2">{{ headline }}</h2>
+      <p class="mb-3">{{ message }}</p>
+      <p class="small text-muted mb-2">
+        Tonight's entertainment: <strong>{{ combo.name }}</strong>
+      </p>
+      <div class="party-buttons">
+        <button type="button" class="btn btn-default btn-sm" @click="playTune('fanfare')">
+          🎺 Fanfare
+        </button>
+        <button type="button" class="btn btn-default btn-sm" @click="playTune('godfather')">
+          🚗 Paulie's horn
+        </button>
+        <button type="button" class="btn btn-default btn-sm" @click="playCombo()">🔁 Again</button>
+        <button type="button" class="btn btn-default btn-sm" @click="nextCombo">
+          🔀 Next combo
+        </button>
+      </div>
+      <p class="party-credits small text-muted mt-3 mb-0">
+        Sounds from Freesound; bard melody by
+        <a href="https://freesound.org/people/Akrythael/sounds/334917/" target="_blank">
+          Akrythael</a
+        >
+        (CC BY-NC 3.0)
+      </p>
+    </div>
+
+    <div
+      v-for="(parrot, index) in parrots"
+      :key="index"
+      class="party-parrot"
+      :style="{
+        transform: `translate(${parrot.x}px, ${parrot.y}px) scaleX(${parrot.vx < 0 ? -1 : 1})`,
+        animationDelay: `${-index * 0.13}s`,
+      }"
+      title="Click me to make me go away"
+      @click="stop"
+    >
+      <svg viewBox="0 0 100 100" width="90" height="90" aria-hidden="true">
+        <!-- tail -->
+        <path d="M30 70 L10 95 L22 92 L28 98 L40 74 Z" fill="#1b7a2f" />
+        <!-- body -->
+        <ellipse cx="45" cy="62" rx="24" ry="22" fill="#3cb043" />
+        <!-- wing -->
+        <path d="M30 55 Q40 82 60 78 Q50 60 30 55 Z" fill="#2a8f37" />
+        <g class="party-parrot-head">
+          <!-- head -->
+          <circle cx="60" cy="38" r="20" fill="#4cc552" />
+          <!-- beak -->
+          <path d="M76 34 Q92 38 80 52 Q78 44 72 42 Z" fill="#f2c14e" />
+          <!-- eye -->
+          <circle cx="66" cy="33" r="5" fill="#fff" />
+          <circle cx="67" cy="33" r="2.6" fill="#222" />
+        </g>
+        <!-- feet -->
+        <path d="M40 83 L38 90 M50 83 L52 90" stroke="#b5651d" stroke-width="3" />
+      </svg>
+    </div>
+  </div>
+</template>
+
+<script>
+// Comma-separated user IDs who get the party on login; read here rather than in resources.js
+// so that this feature only touches App.vue in core code
+const PARTY_USER_IDS = (process.env.VUE_APP_PARTY_USER_IDS || "")
+  .split(",")
+  .map((id) => id.trim())
+  .filter(Boolean);
+const PARTY_WELCOME_MESSAGE =
+  process.env.VUE_APP_PARTY_WELCOME_MESSAGE ||
+  "All hail the top datalab user of the year! The samples have been expecting you.";
+
+const STORAGE_KEY = "datalab-party-welcome-shown";
+const COMBO_STORAGE_KEY = "datalab-party-combo";
+const PARROT_SIZE = 90;
+const PARTY_DURATION_MS = 15000;
+
+// Note frequencies (Hz)
+const G4 = 392.0;
+const AB4 = 415.3;
+const BB4 = 466.16;
+const C5 = 523.25;
+const D5 = 587.33;
+const EB5 = 622.25;
+const E5 = 659.25;
+const G5 = 783.99;
+const C6 = 1046.5;
+
+// Synthesised tunes; notes are [frequency (Hz), start (beats), duration (beats)]
+const TUNES = {
+  // A brassy C major trumpet fanfare
+  fanfare: {
+    wave: "sawtooth",
+    detune: [-6, 6],
+    filter: { type: "lowpass", frequency: 2400 },
+    volume: 0.18,
+    beat: 0.3,
+    gap: 0,
+    notes: [
+      [G4, 0, 0.33],
+      [G4, 0.33, 0.33],
+      [G4, 0.66, 0.33],
+      [C5, 1, 1],
+      [E5, 2, 0.5],
+      [G5, 2.5, 0.5],
+      [E5, 3, 0.33],
+      [G5, 3.33, 0.33],
+      [C6, 3.66, 2],
+    ],
+  },
+  // Paulie Walnuts' Godfather car horn: the opening of the love theme in C minor,
+  // played on buzzy, slightly out-of-tune square waves through a narrow "horn" bandpass
+  godfather: {
+    wave: "square",
+    detune: [-18, 12],
+    filter: { type: "bandpass", frequency: 1300, Q: 0.9 },
+    volume: 0.35,
+    beat: 0.27,
+    gap: 0.03,
+    notes: [
+      [G4, 0, 0.5],
+      [C5, 0.5, 0.5],
+      [EB5, 1, 0.5],
+      [D5, 1.5, 1.5],
+      [C5, 3, 0.5],
+      [EB5, 3.5, 0.5],
+      [C5, 4, 0.5],
+      [D5, 4.5, 0.5],
+      [C5, 5, 0.5],
+      [AB4, 5.5, 0.5],
+      [BB4, 6, 0.5],
+      [G4, 6.5, 2.5],
+    ],
+  },
+};
+
+// Freesound samples served from webapp/public/party-sounds (see CREDITS.md there)
+const SAMPLE_FILES = {
+  airhorn: "airhorn.mp3",
+  bard: "bard-melody.mp3",
+  bikeHorn: "bike-horn.mp3",
+  boing: "boing.mp3",
+  chaChing: "cha-ching.mp3",
+  cheer: "cheer.mp3",
+  damnSon: "damn-son.mp3",
+  drumroll: "drumroll.mp3",
+  goat: "goat.mp3",
+  kazoo: "kazoo-fanfare.mp3",
+  laugh: "laugh.mp3",
+  quack: "quack.mp3",
+  recordScratch: "record-scratch.mp3",
+  rimshot: "rimshot.mp3",
+  sadTrombone: "sad-trombone.mp3",
+  slideWhistle: "slide-whistle.mp3",
+  tada: "tada.mp3",
+  vuvuzela: "vuvuzela.mp3",
+  wilhelm: "wilhelm.mp3",
+  woah: "woah.mp3",
+};
+
+const airhornTriple = (start) =>
+  [0, 0.35, 0.7].map((offset) => ["airhorn", start + offset, { gain: 0.5 }]);
+
+// Login combos, rotated through on each login. Each sound is [name, start (s), options], where
+// name is a sample or a synthesised tune and options are { gain, rate, loop, duration }.
+// Loops keep going until the parrots leave.
+const COMBOS = [
+  {
+    name: "The Original",
+    sounds: [
+      ["bard", 0, { loop: true, gain: 0.3 }],
+      ...airhornTriple(0),
+      ["godfather", 1.6],
+      ["damnSon", 4.3],
+      ["airhorn", 7.4, { gain: 0.5 }],
+      ["airhorn", 7.65, { gain: 0.5, rate: 1.15 }],
+      ["airhorn", 7.9, { gain: 0.5, rate: 1.3 }],
+      ["airhorn", 8.15, { gain: 0.5, rate: 0.8 }],
+    ],
+  },
+  {
+    name: "Drumroll, please",
+    sounds: [
+      ["drumroll", 0, { duration: 3.2, gain: 0.8 }],
+      ["rimshot", 3.2],
+      ["tada", 3.4],
+      ["cheer", 3.6, { gain: 0.6 }],
+      ...airhornTriple(4.5),
+      ["kazoo", 6.5],
+    ],
+  },
+  {
+    name: "Sad trombone fakeout",
+    sounds: [
+      ["sadTrombone", 0],
+      ["recordScratch", 4.0],
+      ["woah", 4.6],
+      ["kazoo", 5.2],
+      ...airhornTriple(6.2),
+      ["godfather", 7.5],
+      ["cheer", 7.5, { gain: 0.5 }],
+    ],
+  },
+  {
+    name: "Old MacDatalab",
+    sounds: [
+      ["quack", 0],
+      ["quack", 0.3, { rate: 1.3 }],
+      ["quack", 0.6, { rate: 0.8 }],
+      ["goat", 1.2],
+      ["bikeHorn", 2.6],
+      ["bikeHorn", 2.9, { rate: 1.2 }],
+      ["bikeHorn", 3.2, { rate: 0.8 }],
+      ["boing", 3.8],
+      ["boing", 4.1, { rate: 1.5 }],
+      ["wilhelm", 4.6],
+      ["slideWhistle", 5.0],
+      ["laugh", 6.5],
+    ],
+  },
+  {
+    name: "Matchday",
+    sounds: [
+      ["vuvuzela", 0, { loop: true, gain: 0.35 }],
+      ["cheer", 0, { gain: 0.7 }],
+      ...airhornTriple(1.0),
+      ["chaChing", 3.0],
+      ["godfather", 4.0],
+      ["damnSon", 7.0],
+      ...airhornTriple(9.5),
+    ],
+  },
+  {
+    name: "The Bard's Tale",
+    sounds: [
+      ["bard", 0, { loop: true, gain: 0.4 }],
+      ["fanfare", 0.5],
+      ["kazoo", 3.0],
+      ["slideWhistle", 5.5],
+      ["boing", 7.4],
+      ["tada", 8.0],
+      ["woah", 8.6, { gain: 0.7 }],
+    ],
+  },
+  {
+    name: "Total chaos",
+    // every sound at once-ish, freshly randomised each time
+    sounds: () => [
+      ...Object.keys(SAMPLE_FILES)
+        .filter((name) => name !== "bard")
+        .map((name) => [name, Math.random() * 8, { gain: 0.5, rate: 0.7 + Math.random() * 0.8 }]),
+      ["godfather", Math.random() * 6],
+      ["fanfare", Math.random() * 6],
+    ],
+  },
+];
+
+function storageGet(key) {
+  try {
+    return localStorage.getItem(key);
+  } catch {
+    return null;
+  }
+}
+
+function storageSet(key, value) {
+  try {
+    if (value === null) {
+      localStorage.removeItem(key);
+    } else {
+      localStorage.setItem(key, value);
+    }
+  } catch {
+    // storage unavailable (e.g., private browsing); the party just happens more often
+  }
+}
+
+export default {
+  name: "PartyWelcome",
+  data() {
+    return {
+      active: false,
+      parrots: [],
+      animationFrame: null,
+      stopTimer: null,
+      lastFrameTime: null,
+      audioContext: null,
+      pendingSoundListener: null,
+      samplePromises: {},
+      loopingSources: [],
+      comboIndex: 0,
+    };
+  },
+  computed: {
+    currentUserID() {
+      return this.$store.state.currentUserID;
+    },
+    currentUserInfoLoaded() {
+      return this.$store.state.currentUserInfoLoaded;
+    },
+    headline() {
+      const name = this.$store.state.currentUserDisplayName;
+      return name ? `Welcome back, ${name}!` : "Welcome back!";
+    },
+    message() {
+      return PARTY_WELCOME_MESSAGE;
+    },
+    combo() {
+      return COMBOS[this.comboIndex];
+    },
+  },
+  watch: {
+    currentUserID: {
+      handler() {
+        this.maybeCelebrate();
+      },
+      immediate: true,
+    },
+    currentUserInfoLoaded() {
+      // Logged out (or session expired): reset so that the next login gets the full treatment
+      if (this.currentUserInfoLoaded && this.currentUserID == null) {
+        storageSet(STORAGE_KEY, null);
+      }
+    },
+  },
+  beforeUnmount() {
+    this.stop();
+  },
+  methods: {
+    maybeCelebrate() {
+      if (this.active || !this.currentUserID || !PARTY_USER_IDS.includes(this.currentUserID)) {
+        return;
+      }
+      const partyParam = new URLSearchParams(window.location.search).get("party");
+      if (partyParam === null && storageGet(STORAGE_KEY) === this.currentUserID) {
+        return;
+      }
+      storageSet(STORAGE_KEY, this.currentUserID);
+      // ?party=N picks combo N (1-based); otherwise rotate to the next one
+      const requested = parseInt(partyParam, 10);
+      if (requested >= 1 && requested <= COMBOS.length) {
+        this.comboIndex = requested - 1;
+      } else {
+        const previous = parseInt(storageGet(COMBO_STORAGE_KEY), 10);
+        this.comboIndex = Number.isNaN(previous) ? 0 : (previous + 1) % COMBOS.length;
+      }
+      storageSet(COMBO_STORAGE_KEY, String(this.comboIndex));
+      this.start();
+    },
+    start() {
+      this.active = true;
+      const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
+      if (!reducedMotion) {
+        const w = window.innerWidth - PARROT_SIZE;
+        const h = window.innerHeight - PARROT_SIZE;
+        this.parrots = [0, 1, 2].map(() => ({
+          x: Math.random() * w,
+          y: Math.random() * h,
+          vx: (Math.random() < 0.5 ? -1 : 1) * (200 + Math.random() * 200),
+          vy: (Math.random() < 0.5 ? -1 : 1) * (150 + Math.random() * 200),
+        }));
+        this.lastFrameTime = null;
+        this.animationFrame = requestAnimationFrame(this.step);
+      }
+      this.stopTimer = setTimeout(this.windDown, PARTY_DURATION_MS);
+      this.playCombo({ waitForInteraction: true });
+    },
+    step(timestamp) {
+      const dt = this.lastFrameTime == null ? 0 : (timestamp - this.lastFrameTime) / 1000;
+      this.lastFrameTime = timestamp;
+      const maxX = window.innerWidth - PARROT_SIZE;
+      const maxY = window.innerHeight - PARROT_SIZE;
+      for (const parrot of this.parrots) {
+        parrot.x += parrot.vx * dt;
+        parrot.y += parrot.vy * dt;
+        if (parrot.x < 0 || parrot.x > maxX) {
+          parrot.vx *= -1;
+          parrot.x = Math.min(Math.max(parrot.x, 0), maxX);
+        }
+        if (parrot.y < 0 || parrot.y > maxY) {
+          parrot.vy *= -1;
+          parrot.y = Math.min(Math.max(parrot.y, 0), maxY);
+        }
+      }
+      this.animationFrame = requestAnimationFrame(this.step);
+    },
+    stopParrots() {
+      if (this.animationFrame) cancelAnimationFrame(this.animationFrame);
+      this.animationFrame = null;
+      this.parrots = [];
+    },
+    windDown() {
+      this.stopParrots();
+      this.stopLoops();
+    },
+    stop() {
+      this.windDown();
+      clearTimeout(this.stopTimer);
+      this.removePendingSoundListener();
+      this.active = false;
+    },
+    stopLoops() {
+      const ctx = this.audioContext;
+      for (const { source, gain } of this.loopingSources) {
+        // fade out rather than cutting off mid-strum
+        gain.gain.setTargetAtTime(0, ctx.currentTime, 0.3);
+        source.stop(ctx.currentTime + 1.5);
+      }
+      this.loopingSources = [];
+    },
+    removePendingSoundListener() {
+      if (this.pendingSoundListener) {
+        window.removeEventListener("pointerdown", this.pendingSoundListener);
+        window.removeEventListener("keydown", this.pendingSoundListener);
+        this.pendingSoundListener = null;
+      }
+    },
+    async getRunningAudioContext(retryOnInteraction = null) {
+      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
+      if (!AudioContextClass) return null;
+      if (!this.audioContext) this.audioContext = new AudioContextClass();
+      const ctx = this.audioContext;
+      if (ctx.state === "suspended") {
+        try {
+          await ctx.resume();
+        } catch {
+          // fall through to the interaction check below
+        }
+      }
+      if (ctx.state !== "running") {
+        // Browsers block audio until the user interacts with the page after a login redirect,
+        // so queue the sound for their first click or keypress instead.
+        if (retryOnInteraction && !this.pendingSoundListener) {
+          this.pendingSoundListener = () => {
+            this.removePendingSoundListener();
+            retryOnInteraction();
+          };
+          window.addEventListener("pointerdown", this.pendingSoundListener);
+          window.addEventListener("keydown", this.pendingSoundListener);
+        }
+        return null;
+      }
+      this.removePendingSoundListener();
+      return ctx;
+    },
+    loadSample(ctx, name) {
+      if (!this.samplePromises[name]) {
+        this.samplePromises[name] = fetch(
+          `${process.env.BASE_URL}party-sounds/${SAMPLE_FILES[name]}`,
+        )
+          .then((response) => response.arrayBuffer())
+          .then((data) => ctx.decodeAudioData(data))
+          // a missing sample just means a slightly less obnoxious party
+          .catch(() => null);
+      }
+      return this.samplePromises[name];
+    },
+    nextCombo() {
+      this.comboIndex = (this.comboIndex + 1) % COMBOS.length;
+      storageSet(COMBO_STORAGE_KEY, String(this.comboIndex));
+      this.playCombo();
+    },
+    async playCombo({ waitForInteraction = false } = {}) {
+      const ctx = await this.getRunningAudioContext(
+        waitForInteraction ? () => this.playCombo() : null,
+      );
+      if (!ctx) return;
+      const combo = this.combo;
+      const sounds = typeof combo.sounds === "function" ? combo.sounds() : combo.sounds;
+      const sampleNames = [...new Set(sounds.map(([name]) => name).filter((n) => SAMPLE_FILES[n]))];
+      const samples = Object.fromEntries(
+        await Promise.all(sampleNames.map(async (n) => [n, await this.loadSample(ctx, n)])),
+      );
+      // bail if the party was closed, or the combo changed, while samples were loading
+      if (!this.active || combo !== this.combo) return;
+      this.stopLoops();
+
+      const t0 = ctx.currentTime + 0.05;
+      for (const [name, start, { loop = false, gain = 1, rate = 1, duration } = {}] of sounds) {
+        if (TUNES[name]) {
+          this.scheduleTune(ctx, TUNES[name], t0 + start);
+          continue;
+        }
+        if (!samples[name]) continue;
+        const source = ctx.createBufferSource();
+        source.buffer = samples[name];
+        source.loop = loop;
+        source.playbackRate.value = rate;
+        const gainNode = ctx.createGain();
+        gainNode.gain.value = gain;
+        source.connect(gainNode).connect(ctx.destination);
+        if (duration) {
+          source.start(t0 + start, 0, duration);
+        } else {
+          source.start(t0 + start);
+        }
+        if (loop) this.loopingSources.push({ source, gain: gainNode });
+      }
+    },
+    async playTune(name) {
+      const ctx = await this.getRunningAudioContext();
+      if (ctx && TUNES[name]) this.scheduleTune(ctx, TUNES[name], ctx.currentTime + 0.05);
+    },
+    scheduleTune(ctx, tune, t0) {
+      const master = ctx.createGain();
+      master.gain.value = tune.volume;
+      const filter = ctx.createBiquadFilter();
+      filter.type = tune.filter.type;
+      filter.frequency.value = tune.filter.frequency;
+      filter.Q.value = tune.filter.Q ?? 1;
+      filter.connect(master).connect(ctx.destination);
+
+      for (const [freq, start, length] of tune.notes) {
+        const begin = t0 + start * tune.beat;
+        const end = begin + length * tune.beat - tune.gap;
+        for (const detune of tune.detune) {
+          const osc = ctx.createOscillator();
+          osc.type = tune.wave;
+          osc.frequency.value = freq;
+          osc.detune.value = detune;
+          const env = ctx.createGain();
+          env.gain.setValueAtTime(0, begin);
+          env.gain.linearRampToValueAtTime(0.5, begin + 0.02);
+          env.gain.setValueAtTime(0.4, Math.max(begin + 0.02, end - 0.04));
+          env.gain.linearRampToValueAtTime(0, end);
+          osc.connect(env).connect(filter);
+          osc.start(begin);
+          osc.stop(end + 0.05);
+        }
+      }
+    },
+  },
